---
import Manual from '../layouts/Manual.astro';
import Rule from '../components/Rule.astro';
import { typeStyles } from '../lib/tokens';
const styles = typeStyles().filter((s) => s.name !== 'monogram');
const families = [
  { key: 'ui', name: 'Inter', role: 'Interfaz y textos largos', note: 'Pesos 400, 500 y 600. Licencia OFL.', link: 'https://fonts.google.com/specimen/Inter' },
  { key: 'display', name: 'Rubik', role: 'Titulares de marca', note: 'Splash, banners, redes sociales y portadas.', link: 'https://fonts.google.com/specimen/Rubik' },
  { key: 'serif', name: 'PT Serif Bold', role: 'Solo monograma', note: 'Las dos «C» del logo. No se usa para texto.', link: 'https://fonts.google.com/specimen/PT+Serif' },
  { key: 'wordmark', name: 'Alumni Sans SC', role: 'Solo wordmark', note: '«Cicerón» en el logo. No se usa para texto.', link: 'https://fonts.google.com/specimen/Alumni+Sans+SC' },
];
---
<Manual title="Tipografía">
  <p class="eyebrow">04</p>
  <h1>Tipografía</h1>
  <p class="lead">Dos familias para trabajar — Inter para la interfaz y Rubik para la marca — y dos más que viven solo dentro del logo.</p>

  <h2>Familias</h2>
  <div class="grid g2">
    {families.map((f) => (
      <div class="card">
        <div class="spec" style={`font-family:var(--font-${f.key})`}>
          <span class="aa" style={f.key === 'serif' ? 'font-weight:700' : ''}>Aa</span>
          <span class="abc" style={f.key === 'wordmark' ? 'font-size:22px;line-height:1.3' : ''}>ABCDEFGHIJKLMNÑOPQRSTUVWXYZ<br />abcdefghijklmnñopqrstuvwxyz<br />0123456789 ¿?¡! áéíóú</span>
        </div>
        <div class="card-body"><p class="card-title">{f.name} · {f.role}</p><p class="card-text">{f.note} <a href={f.link}>Ver en Google Fonts</a></p></div>
      </div>
    ))}
  </div>

  <h2>Escala</h2>
  <p>Tamaños fijos en múltiplos de 4 px. Usa siempre un estilo de la escala, no tamaños sueltos.</p>
  <div class="scale">
    {styles.map((s) => (
      <div class="row">
        <div class="meta"><code>{s.name}</code><span>{s.group} · {s.fontSize}/{s.lineHeight} · {s.fontWeight}</span></div>
        <p style={`font-family:var(--font-${s.familyKey});font-size:${s.fontSize};line-height:${s.lineHeight};font-weight:${s.fontWeight};margin:0`}>
          {s.sample ?? 'Diseña sin conexión, a tu manera.'}
        </p>
      </div>
    ))}
  </div>

  <h2>Pesos</h2>
  <div class="weights">
    <div><span style="font-weight:400">Regular 400</span><p>Párrafos y valores.</p></div>
    <div><span style="font-weight:500">Medium 500</span><p>Etiquetas y textos pequeños.</p></div>
    <div><span style="font-weight:600">Semibold 600</span><p>Títulos y énfasis.</p></div>
  </div>

  <h2>Reglas</h2>
  <div class="grid g2">
    <Rule type="do">Mayúscula solo inicial en títulos y botones: «Nuevo diseño».</Rule>
    <Rule type="dont">No escribas títulos completos en MAYÚSCULAS ni en Tipo Título.</Rule>
    <Rule type="do">Interlineado de 1.25 a 1.4; párrafos de 60 a 75 caracteres.</Rule>
    <Rule type="dont">No uses PT Serif ni Alumni Sans SC fuera del logo.</Rule>
    <Rule type="do">Cifras tabulares en tablas y valores numéricos.</Rule>
    <Rule type="dont">No uses pesos 300 ni 700 de Inter.</Rule>
  </div>
</Manual>
<style>
  .spec { padding: 20px; display: flex; gap: 20px; align-items: center; border-bottom: var(--stroke-1) solid var(--border-subtle); min-height: 150px; }
  .aa { font-size: 72px; line-height: 1; color: var(--text-accent); }
  .abc { font-size: 15px; line-height: 1.5; color: var(--text-secondary); word-break: break-all; }
  .scale { margin-top: 16px; border-top: var(--stroke-1) solid var(--border-subtle); }
  .row { display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: baseline; padding: 16px 0; border-bottom: var(--stroke-1) solid var(--border-subtle); }
  .meta { display: flex; flex-direction: column; gap: 2px; font-size: 12px; color: var(--text-muted); }
  .weights { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 16px; }
  .weights span { font-size: 28px; }
  .weights p { margin: 4px 0 0; color: var(--text-secondary); font-size: 14px; }
  @media (max-width: 760px) { .row { grid-template-columns: 1fr; gap: 4px; } .weights { grid-template-columns: 1fr; } }
</style>
